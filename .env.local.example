# ── engine ─────────────────────────────────────────────────────────
# Set a key to switch the demo from the fixture corpus to real model calls.
# Leave BOTH set (offline) for a public deploy: a key on a public URL is your
# quota on the open internet.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OFFLINE_DEMO=1

# ── per-prospect tuning (one deploy per prospect, zero code edits) ──
# These appear in sentences a client reads, so they are NEXT_PUBLIC_*.
NEXT_PUBLIC_CLIENT_NAME=Northwind Supply Co
NEXT_PUBLIC_CLIENT_INDUSTRY=distribution
NEXT_PUBLIC_DAILY_VOLUME=60
NEXT_PUBLIC_HOURLY_COST=34
NEXT_PUBLIC_BUILD_FEE=450
NEXT_PUBLIC_MONTHLY_FEE=120
NEXT_PUBLIC_DEMO_URL=https://conduit-demo-version.vercel.app
NEXT_PUBLIC_MAX_LIVE_DOCS=4
