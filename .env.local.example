# Conduit — what this deployment reads from the environment.
#
# There is no access code. The page is open on purpose, and it is safe because of what the endpoint
# refuses to do — rules only, no model, nothing stored — not because of who is allowed in. So there is
# nothing secret to configure here.
#
# NEXT_PUBLIC_* values are compiled into what a visitor can read, so they are never secrets. Do not put
# an API key in this file or in the project: a key on a public deployment is someone else's bill, and a
# free-tier key pointed at a public page puts strangers' documents into a model's training data.

# ── per-prospect tuning (one deploy per prospect, no code edits) ──────────────
NEXT_PUBLIC_CLIENT_NAME=Northwind Supply Co
NEXT_PUBLIC_INTAKE_ADDRESS=ops@northwind.example
NEXT_PUBLIC_TAGLINE=Inbound document automation
NEXT_PUBLIC_DEMO_URL=https://conduit-demo-version.vercel.app
# Their stack. Naming the system someone types into is what turns a look into a meeting.
NEXT_PUBLIC_SYSTEMS=ERP=NetSuite,AP=Xero,WMS=SAP Business One,CRM=HubSpot

# ── the bounds that make an open endpoint affordable ───────────────────────────
PILOT_MAX_DOCS=12
PILOT_MAX_BYTES=1500000
PILOT_MAX_CHARS=12000

# ── the private pilot build only; nothing on the public page reaches these ─────
OFFLINE_DEMO=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
